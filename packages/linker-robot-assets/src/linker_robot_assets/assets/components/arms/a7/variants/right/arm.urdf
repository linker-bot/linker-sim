<?xml version="1.0" encoding="utf-8"?>
<!-- A7 right arm. Kinematics (axes, limits, joint origins J2..J7,
     effort/velocity) come from the SDK per-side URDF a7__right.urdf — the
     URDF the real robot/recorder uses (linkerbot-python-sdk kinetix loads
     limits straight from it). The combined data-collection source
     (数采方案1.SLDASM) has flipped sign conventions on several joints
     (verified: right flips) and CAD-nominal limits, so it is NOT used for
     kinematics — only its inertials + STL meshes are kept, since those match
     the base_link/Link_r* meshes this component ships.

     Re-rooted at a zero-mass virtual link R_arm_root so the recipe's fixed
     mount joint lives above the first revolute R1_Joint. The source
     base_link -> joint_r1 origin is absorbed into a7_torso's arm_right_mount
     pad, so R1_Joint sits at xyz=0 here. -->
<robot name="a7_right">

  <link name="R_arm_root" />

  <link name="R1_Link">
    <inertial>
      <origin xyz="0.002708 -0.063352 -7.9383E-05" rpy="0 0 0" />
      <mass value="0.33055" />
      <inertia
        ixx="0.0004215" ixy="1.5467E-05" ixz="6.104E-08"
        iyy="0.0001625" iyz="2.0807E-06"
        izz="0.00035691" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R1_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R1_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R1_Joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="R_arm_root" />
    <child link="R1_Link" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.05" upper="2.97" effort="80" velocity="10" />
  </joint>

  <link name="R2_Link">
    <inertial>
      <origin xyz="-0.031959 5.0041E-06 -0.068645" rpy="0 0 0" />
      <mass value="0.27885" />
      <inertia
        ixx="0.00052682" ixy="6.678E-09" ixz="1.3195E-06"
        iyy="0.00044111" iyz="-1.7357E-08"
        izz="0.00018578" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R2_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R2_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R2_Joint" type="revolute">
    <origin xyz="0.0328 -0.075 0" rpy="0 0 0" />
    <parent link="R1_Link" />
    <child link="R2_Link" />
    <axis xyz="1 0 0" />
    <limit lower="-3.49" upper="0.35" effort="80" velocity="10" />
  </joint>

  <link name="R3_Link">
    <inertial>
      <origin xyz="0.0040768 -0.00046081 -0.10122" rpy="0 0 0" />
      <mass value="0.29571" />
      <inertia
        ixx="0.00068049" ixy="5.4932E-08" ixz="4.8841E-05"
        iyy="0.00063555" iyz="-1.3613E-07"
        izz="0.00015786" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R3_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R3_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R3_Joint" type="revolute">
    <origin xyz="-0.0328 0 -0.12" rpy="0 0 0" />
    <parent link="R2_Link" />
    <child link="R3_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-2.79" upper="2.79" effort="36" velocity="10" />
  </joint>

  <link name="R4_Link">
    <inertial>
      <origin xyz="-0.0095862 -0.031592 -0.070292" rpy="0 0 0" />
      <mass value="0.25138" />
      <inertia
        ixx="0.00028685" ixy="-3.2093E-07" ixz="-6.4912E-06"
        iyy="0.00034007" iyz="-1.1689E-06"
        izz="0.00015409" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R4_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R4_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R4_Joint" type="revolute">
    <origin xyz="0.0095 0.0325 -0.15" rpy="0 0 0" />
    <parent link="R3_Link" />
    <child link="R4_Link" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.21" upper="2.355" effort="36" velocity="10" />
  </joint>

  <link name="R5_Link">
    <inertial>
      <origin xyz="5.5132E-05 -0.0078207 -0.05531" rpy="0 0 0" />
      <mass value="0.13958" />
      <inertia
        ixx="5.9203E-05" ixy="8.2373E-08" ixz="1.2818E-08"
        iyy="7.6816E-05" iyz="8.9324E-06"
        izz="4.7942E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R5_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R5_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R5_Joint" type="revolute">
    <origin xyz="-0.0095 -0.0325 -0.11" rpy="0 0 0" />
    <parent link="R4_Link" />
    <child link="R5_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-2.79" upper="2.79" effort="36" velocity="10" />
  </joint>

  <link name="R6_Link">
    <inertial>
      <origin xyz="-0.0053865 -0.017496 -0.057544" rpy="0 0 0" />
      <mass value="0.16212" />
      <inertia
        ixx="0.0001356" ixy="3.8677E-06" ixz="3.0459E-06"
        iyy="9.7781E-05" iyz="-1.7636E-05"
        izz="6.6953E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R6_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R6_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R6_Joint" type="revolute">
    <origin xyz="0 0.022 -0.06" rpy="0 0 0" />
    <parent link="R5_Link" />
    <child link="R6_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="36" velocity="10" />
  </joint>

  <link name="R7_Link">
    <inertial>
      <origin xyz="-0.086955 0.027834 -0.032643" rpy="0 0 0" />
      <mass value="0.30286" />
      <inertia
        ixx="0.00038963" ixy="0.00016057" ixz="9.5278E-05"
        iyy="0.0003878" iyz="-6.63E-05"
        izz="0.00060212" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R7_Link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/R7_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="R7_Joint" type="revolute">
    <origin xyz="0.0225 -0.022 -0.064" rpy="0 0 0" />
    <parent link="R6_Link" />
    <child link="R7_Link" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="36" velocity="10" />
  </joint>

</robot>
